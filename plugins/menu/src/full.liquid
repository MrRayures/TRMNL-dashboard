{% comment %}
  Canteen menu, full view. The "display" custom field picks the layout:
  - day (default): the day's lunch and snack, its date as heading; on days
    without service, a notice and the next published menu.
  - week: one column per served day of the school week,
    today's column on a light background.
  Footer, both layouts: "Menu du 23 au 27 novembre".
  Merge variables come from transform.js (see README.md).
{% endcomment %}
{% assign display = trmnl.plugin_settings.custom_fields_values.display | default: "day" %}

<div class="layout layout--col layout--top">
  {% if display == "week" and week.size > 0 %}
    {% comment %} Equal columns (grow + basis--0); today's on a light background. {% endcomment %}
    <div class="flex flex--row flex--stretch-y gap w--full h--full">
      {% for day in week %}
        <div class="flex flex--col gap--small flex--left flex--top grow basis--0 p--4 rounded--large{% if day.today %} bg--gray-75{% endif %}" data-overflow="true">
          <span class="title title--small font--bold">{{ day.weekday }} {{ day.day }}</span>
          {% if day.lunch.size > 0 %}
            {% render "menu/meal", title: "Déjeuner", courses: day.lunch, compact: true %}
          {% endif %}
          {% if day.snack.size > 0 %}
            <hr class="border--h-75 w--full" />
            {% render "menu/meal", title: "Goûter", courses: day.snack, compact: true %}
          {% endif %}
        </div>
      {% endfor %}
    </div>

  {% elsif lunch.size > 0 or snack.size > 0 %}
    <div class="flex flex--col gap--small flex--left flex--top w--full" data-overflow="true">
      <div class="flex flex--col flex--left w--full">
        {% unless service %}
          <span class="description">Pas de service aujourd'hui. Prochain repas :</span>
        {% endunless %}
        <span class="title title--large">{{ day_label }}</span>
      </div>
      <hr class="border--h-10 w--full" />

      {% if lunch.size > 0 %}
        {% render "menu/meal", title: "Déjeuner", courses: lunch %}
      {% endif %}

      {% if snack.size > 0 %}
        <hr class="border--h-75 w--full" />
        {% render "menu/meal", title: "Goûter", courses: snack %}
      {% endif %}
    </div>

  {% else %}
    <div class="flex flex--col flex--left w--full">
      <span class="title">Pas de service aujourd'hui</span>
      <span class="description">Aucun menu publié pour les prochains jours</span>
    </div>
  {% endif %}
</div>

{% if week_label != blank %}
  {% assign bar_title = "Menu " | append: week_label %}
{% else %}
  {% assign bar_title = trmnl.plugin_settings.instance_name %}
{% endif %}
{% render "menu/title_bar", title: bar_title, date: today_label %}
