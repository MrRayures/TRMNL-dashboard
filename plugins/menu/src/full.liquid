{% comment %}
  Canteen menu, full view: lunch courses plus the afternoon snack.
  Payload contract: see README.md and fixtures/ (service, date_label, lunch[], snack[]).
  Labels (BIO/AOC/AOP) come from the ingredient level upstream and arrive flattened.
{% endcomment %}
<div class="layout layout--col layout--top layout--align-start">
  {% if service %}
    <div class="flex flex--col gap--small flex--left flex--top w--full" data-overflow="true">
      {% for course in lunch %}
        <div class="item">
          <div class="content">
            <span class="description">{{ course.dish }}</span>
            <div class="flex flex--row gap--small">
              <span class="title">{{ course.name }}</span>
              {% for tag in course.labels %}
                <span class="label label--small label--outline">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>
        </div>
      {% endfor %}

      {% if snack.size > 0 %}
        <hr class="border--h-10 w--full" />
        {% for course in snack %}
          <div class="item">
            <div class="content">
              <span class="description">{{ course.dish }}</span>
              <span class="title">{{ course.name }}</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  {% else %}
    <span class="title">Pas de service aujourd'hui</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ date_label }}</span>
</div>
